.claude/worktrees/
node_modules
package-lock.json
.env
pipeline/local-biz/sites/
pipeline/local-biz/leads.csv
pipeline/local-biz/emails.csv
pipeline/local-biz/email-errors.log

# Cloudflare local state and secrets
.wrangler/
.dev.vars

# Law audit raw downloads (hashes are kept in the .json records)
foundry/out/law-audit/raw/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
