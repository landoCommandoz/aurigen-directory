{
  "name": "lando-masterclass-101",
  "version": "0.1.0",
  "private": true,
  "description": "Lando's Detailing Masterclass 101: offline-first shop app (Fix It, Shop Mode, Academy, Customer View, Business).",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content": "tsx scripts/content/build-content.ts",
    "icons": "tsx scripts/icons/build-icons.ts",
    "check": "npm run typecheck && npm run lint && npm run content && npm run test"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wawoff2": "^2.0.1"
  }
}
