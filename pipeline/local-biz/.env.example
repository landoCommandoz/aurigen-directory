# Google Places API - used by scraper.js
# console.cloud.google.com -> enable Places API ($200/month free usage)
GOOGLE_PLACES_API_KEY=

# Anthropic API - used by generator.js
# Optional: no credits? See "Zero-Budget Mode" in README - Claude Code writes the sites instead
ANTHROPIC_API_KEY=

# Surge.sh - used by deployer.js (free, no card required)
# One-time setup:
#   npx surge login
#   npx surge token
SURGE_LOGIN=
SURGE_TOKEN=
