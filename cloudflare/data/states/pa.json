    "statute": "72 P.S. §5860.601–609"
   },
   "stage2": {
    "name": "Judicial Sale (Free and Clear Sale)",
    "description": "Properties not sold at Upset Sale or removed. Sold FREE AND CLEAR of all liens — title insurable.",
