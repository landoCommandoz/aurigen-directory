   ],
   "depositInfo": "Varía. GovEase requiere fondos anticipados.",
   "directLink": "https://govease.com"
  },
  "otc": {
   "available": true,
   "note": "Tierra fiscal estatal disponible para compra directa en GovEase.com durante todo el año."
